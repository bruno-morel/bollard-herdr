layout {

    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="DEV" focus=true {
        pane split_direction="vertical" {
            pane size="70%" name="CODEX" command="codex"

            pane size="30%" split_direction="horizontal" {
                pane name="SHELL"

                pane name="LOGS" command="docker" {
                    args "compose" "logs" "-f"
                }
            }
        }
    }

    tab name="TESTS" {
        pane split_direction="vertical" {
            pane size="55%" name="TEST SHELL"

            pane size="45%" split_direction="horizontal" {
                pane name="VALIDATE" command="docker" start_suspended=true {
                    args "compose" "exec" "-T" "tenhumans" "npm" "run" "validate"
                }

                pane name="E2E" command="docker" start_suspended=true {
                    args "compose" "-f" "docker-compose.yml" "-f" "docker-compose.test.yml" "run" "--rm" "e2e" "npm" "test"
                }
            }
        }
    }

    tab name="GIT" {
        pane name="GIT" command="lazygit"
    }
}
